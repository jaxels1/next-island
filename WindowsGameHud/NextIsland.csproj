<Project Sdk="Microsoft.NET.Sdk">
  <!-- Added 2026-11-12 for the local Windows gaming HUD. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The WPF host declares PerMonitorV2 in its manifest. WinForms supplies only the tray menu. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NextIsland</AssemblyName>
    <Product>Next Island</Product>
    <Version>0.2.0</Version>
    <StartupObject>SapphireGameHud.App</StartupObject>
    <RootNamespace>SapphireGameHud</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
