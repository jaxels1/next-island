<Window x:Class="SapphireGameHud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireGameHud"
        Title="Next Island" Width="1130" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Added 2026-11-12 for the local Windows gaming HUD. -->
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Text" Value="—"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HitArea" CornerRadius="19" Background="{TemplateBinding Background}"
                                    local:ButtonPress.Scale=".96" IsHitTestVisible="False">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="{StaticResource ControlFill}"/>
                                <Setter TargetName="HitArea" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid x:Name="Scene" Width="1130" Height="300" ClipToBounds="True">
            <local:IslandSurface x:Name="Membrane" IsHitTestVisible="False"/>
            <Canvas>
                <Grid x:Name="Island" Width="100" Height="0" ClipToBounds="True">
                    <Grid x:Name="PanelViewport" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="CompactContent" Width="176" Height="38" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Focusable="False"
                            AutomationProperties.Name="Open island" Visibility="Collapsed">
                        <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="27"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactTile" Width="26" Height="26" CornerRadius="7" Background="{StaticResource Recessed}" HorizontalAlignment="Left">
                            <Grid>
                                <Path Width="15" Height="10" Stretch="Fill" Stroke="{StaticResource Muted}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M0,8 L5,8 L8,2 L12,13 L16,5 L19,8 L23,8"/>
                                <Rectangle x:Name="CompactArt" RadiusX="7" RadiusY="7" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="Next Island" Foreground="{StaticResource Ink}"
                                   FontFamily="{StaticResource IslandFont}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBlock x:Name="CompactClock" Grid.Column="2" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   FontFamily="{StaticResource IslandFont}" FontSize="11" VerticalAlignment="Center"/>
                        <local:PlaybackBars x:Name="CompactPlayback" Grid.Column="2" Width="16" Height="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Border x:Name="TelemetryContent" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Padding="12,0" TextElement.FontFamily="{StaticResource IslandFont}"
                            TextElement.FontSize="13" IsHitTestVisible="False" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition x:Name="SecondaryMetricsRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FpsColumn" Width=".85*"/>
                                <ColumnDefinition x:Name="FrameColumn" Width="1.15*"/>
                                <ColumnDefinition x:Name="CpuColumn" Width="1.4*"/>
                                <ColumnDefinition x:Name="GpuColumn" Width="1.4*"/>
                                <ColumnDefinition x:Name="RamColumn" Width=".95*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="MusicColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Frames per second">
                                <TextBlock Text="FPS" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Fps" Style="{StaticResource MetricValue}" MinWidth="32" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel x:Name="FrameGroup" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Frame time">
                                <TextBlock Text="Frame" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="FrameTime" Style="{StaticResource MetricValue}" MinWidth="59" Text="">
                                    <Run x:Name="FrameTimeNumber" Text="—"/><Run x:Name="FrameTimeUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="CpuGroup" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="System CPU utilization and temperature">
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Cpu" Style="{StaticResource MetricValue}" MinWidth="38" Text="">
                                    <Run x:Name="CpuNumber" Text="—"/><Run x:Name="CpuUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock x:Name="CpuTemp" Style="{StaticResource MetricValue}" MinWidth="43" Margin="7,0,0,0" Text="">
                                    <Run x:Name="CpuTempNumber" Text="—"/><Run x:Name="CpuTempUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="GpuGroup" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="System GPU utilization and temperature">
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Gpu" Style="{StaticResource MetricValue}" MinWidth="38" Text="">
                                    <Run x:Name="GpuNumber" Text="—"/><Run x:Name="GpuUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock x:Name="GpuTemp" Style="{StaticResource MetricValue}" MinWidth="43" Margin="7,0,0,0" Text="">
                                    <Run x:Name="GpuTempNumber" Text="—"/><Run x:Name="GpuTempUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="RamGroup" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="System RAM usage">
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Ram" Style="{StaticResource MetricValue}" MinWidth="38" Text="">
                                    <Run x:Name="RamNumber" Text="—"/><Run x:Name="RamUnit" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                            <local:FrameGraph x:Name="Graph" Grid.Column="5" Width="78" Height="15" Margin="12,0,6,0"
                                              VerticalAlignment="Center" Visibility="Collapsed"
                                              AutomationProperties.Name="Recent frame times"/>
                            <TextBlock x:Name="PreviewLabel" Grid.Column="6" Grid.RowSpan="2" Text="Preview" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" Margin="10,0,2,0" Visibility="Collapsed"/>
                            <Grid x:Name="GameTrack" Grid.Column="7" Grid.RowSpan="2" Width="154" HorizontalAlignment="Left"
                                  ClipToBounds="True" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="5" Background="{StaticResource ControlFill}">
                                    <Grid>
                                        <Path Width="9" Height="10" Stretch="Uniform" Stroke="{StaticResource Ink}" StrokeThickness="1.4"
                                              Data="{StaticResource MusicIcon}"/>
                                        <Rectangle x:Name="GameArt" RadiusX="5" RadiusY="5" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="GameTrackTitle" Grid.Column="2" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" Margin="7,0,6,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <local:PlaybackBars x:Name="GamePlayback" Grid.Column="3" Amplitude=".32" Width="16" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
