<Window x:Class="SapphireGameHud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireGameHud"
        Title="Next Island" Width="976" Height="264"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Added 2026-11-12 for the local Windows gaming HUD. -->
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryInk" Color="#F6F7FA"/>
        <SolidColorBrush x:Key="SecondaryInk" Color="#A4A6B0"/>
        <SolidColorBrush x:Key="FrameInk" Color="#A8EDCC"/>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryInk}"/>
            <Setter Property="Text" Value="—"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HitArea" CornerRadius="16" Background="{TemplateBinding Background}"
                                    local:ButtonPress.Scale=".96" IsHitTestVisible="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#25262B"/>
                                <Setter TargetName="HitArea" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid x:Name="Scene" Width="976" Height="264" ClipToBounds="True">
            <local:IslandSurface x:Name="Membrane" IsHitTestVisible="False"/>
            <Canvas>
                <Grid x:Name="Island" Width="100" Height="0" ClipToBounds="True">
                    <Grid x:Name="PanelViewport" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="CompactContent" Width="180" Height="32" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Focusable="False"
                            AutomationProperties.Name="Open island" Visibility="Collapsed">
                        <Grid Width="158">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactTile" Width="21" Height="21" CornerRadius="6" Background="#24262D" HorizontalAlignment="Left">
                            <Grid>
                                <Path Width="15" Height="10" Stretch="Fill" Stroke="#D0DCFF"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M0,8 L5,8 L8,2 L12,13 L16,5 L19,8 L23,8"/>
                                <Rectangle x:Name="CompactArt" RadiusX="6" RadiusY="6" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="Sapphire" Foreground="{StaticResource PrimaryInk}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBlock x:Name="CompactClock" Grid.Column="2" TextAlignment="Right" Foreground="{StaticResource SecondaryInk}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                        <local:PlaybackBars x:Name="CompactPlayback" Grid.Column="2" Width="16" Height="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Border x:Name="TelemetryContent" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Padding="14,0" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
                            TextElement.FontSize="13" IsHitTestVisible="False" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="MusicColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Frames per second">
                                <TextBlock Text="FPS" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Fps" Style="{StaticResource MetricValue}" MinWidth="32" Foreground="{StaticResource FrameInk}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Frame time">
                                <TextBlock Text="Frame" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="FrameTime" Style="{StaticResource MetricValue}" MinWidth="59"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="System CPU utilization and temperature">
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Cpu" Style="{StaticResource MetricValue}" MinWidth="38"/>
                                <TextBlock x:Name="CpuTemp" Style="{StaticResource MetricValue}" MinWidth="43" Margin="7,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="System GPU utilization and temperature">
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="Gpu" Style="{StaticResource MetricValue}" MinWidth="38"/>
                                <TextBlock x:Name="GpuTemp" Style="{StaticResource MetricValue}" MinWidth="43" Margin="7,0,0,0"/>
                            </StackPanel>
                            <local:FrameGraph x:Name="Graph" Grid.Column="4" Width="78" Height="15" Margin="12,0,6,0"
                                              VerticalAlignment="Center" Visibility="Collapsed"
                                              AutomationProperties.Name="Recent frame times"/>
                            <TextBlock x:Name="PreviewLabel" Grid.Column="5" Text="Preview" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryInk}" Margin="10,0,2,0" Visibility="Collapsed"/>
                            <Grid x:Name="GameTrack" Grid.Column="6" Width="154" HorizontalAlignment="Left"
                                  ClipToBounds="True" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="1" Height="12" Background="#41434C" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="5" Background="#292B32">
                                    <Grid>
                                        <Path Width="9" Height="10" Stretch="Uniform" Fill="#D6DBE9"
                                              Data="M1,8 C1,6 4,6 5,7 L5,2 L10,0 L10,2 L6,4 L6,8 C6,10 1,11 1,8Z"/>
                                        <Rectangle x:Name="GameArt" RadiusX="5" RadiusY="5" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="GameTrackTitle" Grid.Column="2" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryInk}" Margin="7,0,6,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <local:PlaybackBars x:Name="GamePlayback" Grid.Column="3" Width="16" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
