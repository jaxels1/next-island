<UserControl x:Class="SapphireGameHud.IslandPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireGameHud"
        Width="344" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
    <!-- Added 2026-11-12 for the Windows island. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F6F6F8"/>
        <SolidColorBrush x:Key="Muted" Color="#B4B5BF"/>
        <SolidColorBrush x:Key="Accent" Color="#D0DCFF"/>
        <SolidColorBrush x:Key="Recessed" Color="#17181D"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="KeyboardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#282A31"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="14"
                                    Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#393B44"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#484B55"/>
                                <Setter TargetName="Shell" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolChoice" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource Recessed}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="11,5"
                                    local:ButtonPress.Scale=".975" IsHitTestVisible="False">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Right" Data="M2,1 L6,5 L2,9" Stroke="{StaticResource Muted}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="5" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#282A31"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#393B44"/>
                                <Setter TargetName="Row" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Recessed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#23242A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#30323A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TextRow">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12"/>
        </DataTemplate>
        <Style x:Key="ControlIcon" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="SeekTrack" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="3" CornerRadius="1.5" Background="#3D3E46" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"><Border Height="3" Background="{StaticResource Accent}"
                                                    CornerRadius="1.5" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="11">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Accent}"/>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DurationChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Choice" CornerRadius="8" Background="Transparent" Padding="7,5"
                                    IsHitTestVisible="False">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#292B32"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="#353842"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="#484B55"/>
                                <Setter TargetName="Choice" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="PanelBody" Margin="16,14,16,11">
        <StackPanel x:Name="MusicView">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ArtTile" Background="#202127" Width="64" Height="64" HorizontalAlignment="Left"
                        VerticalAlignment="Center" CornerRadius="10" RenderTransformOrigin=".5,.5">
                    <Grid>
                        <Path Fill="{StaticResource Muted}" Stretch="Uniform" Width="22" Height="22"
                              Data="M8,17.4 C8,19 6.4,20 4.8,20 C3.2,20 2,19.1 2,17.8 C2,16.3 3.6,15.2 5.3,15.2 C5.6,15.2 5.8,15.2 6,15.3 L6,5 L19,2 L19,14 C19,15.6 17.5,16.7 15.8,16.7 C14.2,16.7 13,15.8 13,14.5 C13,13 14.6,11.9 16.3,11.9 C16.5,11.9 16.7,11.9 17,12 L17,6 L8,8 Z"/>
                        <Rectangle x:Name="AlbumArt" RadiusX="10" RadiusY="10" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="TrackDetails" ClipToBounds="True">
                        <TextBlock x:Name="TrackName" Text="Nothing playing" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistName" Text="Start playback in a media app."
                                   Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="Transport" Orientation="Horizontal" Margin="-4,2,0,0" Visibility="Collapsed">
                        <Button x:Name="Previous" Style="{StaticResource Action}" Background="Transparent"
                                Padding="0" Width="34" Click="PreviousTrack" ToolTip="Previous track"
                                AutomationProperties.Name="Previous track" IsEnabled="False">
                            <Path Style="{StaticResource ControlIcon}" Data="M1,1 L4,1 L4,15 L1,15 Z M15,1 L15,15 L5,8 Z"/>
                        </Button>
                        <Button x:Name="Toggle" Style="{StaticResource Action}" Width="40" Margin="4,0" Padding="0"
                                Click="ToggleTrack" Background="#2C2D34" ToolTip="Play"
                                AutomationProperties.Name="Play" IsEnabled="False">
                            <Grid>
                                <Path x:Name="PlayGlyph" Style="{StaticResource ControlIcon}" Data="M2,0 L15,8 L2,16 Z"/>
                                <Path x:Name="PauseGlyph" Style="{StaticResource ControlIcon}" Opacity="0"
                                      Data="M2,1 L6,1 L6,15 L2,15 Z M10,1 L14,1 L14,15 L10,15 Z"/>
                            </Grid>
                        </Button>
                        <Button x:Name="Next" Style="{StaticResource Action}" Background="Transparent"
                                Padding="0" Width="34" Click="NextTrack" ToolTip="Next track"
                                AutomationProperties.Name="Next track" IsEnabled="False">
                            <Path Style="{StaticResource ControlIcon}" Data="M15,1 L12,1 L12,15 L15,15 Z M1,1 L1,15 L11,8 Z"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid x:Name="Timeline" Margin="0,5,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Elapsed" Style="{StaticResource Quiet}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Style="{StaticResource SeekTrack}" IsEnabled="False" IsMoveToPointEnabled="True"
                        SmallChange="5" LargeChange="15" ValueChanged="SeekChanged"
                        PreviewMouseLeftButtonUp="FinishSeek" AutomationProperties.Name="Playback position"/>
                <TextBlock x:Name="Duration" Grid.Column="2" Style="{StaticResource Quiet}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="OpenTools" DockPanel.Dock="Right" Style="{StaticResource Action}" Padding="9,4"
                        Background="Transparent" Click="Navigate" Tag="Tools">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tools"/>
                        <Path Data="M2,1 L6,5 L2,9" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="5" Height="9" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="MusicStatus" Style="{StaticResource Quiet}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </StackPanel>

        <Grid x:Name="ToolHeader" Margin="0,0,0,9" Visibility="Collapsed">
            <Button x:Name="Back" Style="{StaticResource Action}" Width="34" Padding="0"
                    HorizontalAlignment="Left" Background="Transparent" Click="GoBack"
                    ToolTip="Back" AutomationProperties.Name="Back">
                <Path Data="M7,1 L2,6 L7,11" Stroke="{StaticResource Ink}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="8" Height="12" Stretch="Uniform"/>
            </Button>
            <TextBlock x:Name="ViewTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
        </Grid>

        <StackPanel x:Name="ToolsView" Visibility="Collapsed">
            <Button x:Name="ShelfChoice" Style="{StaticResource ToolChoice}" Content="File Shelf"
                    Click="Navigate" Tag="Shelf"/>
            <Button Style="{StaticResource ToolChoice}" Content="Clipboard" Click="Navigate" Tag="Clipboard"/>
            <Button Style="{StaticResource ToolChoice}" Content="Timer" Click="Navigate" Tag="Timer" Margin="0"/>
        </StackPanel>

        <StackPanel x:Name="ShelfView" Visibility="Collapsed" AllowDrop="True" Drop="AddDroppedFiles"
                    DragOver="ShowDropEffect" Background="Transparent">
            <Grid Height="82">
                <ListBox x:Name="Files" ItemTemplate="{StaticResource TextRow}" AutomationProperties.Name="File shelf"
                         PreviewMouseLeftButtonDown="StartFileDrag" PreviewMouseMove="DragFile"
                         MouseDoubleClick="OpenSelectedFile" KeyDown="OpenSelectedFileWithKeyboard"/>
                <TextBlock x:Name="ShelfEmpty" Text="Drop files here" Style="{StaticResource Quiet}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddFile" Style="{StaticResource Action}" Content="Add files" Click="AddFiles"/>
                <Button x:Name="RemoveFile" Style="{StaticResource Action}" Content="Remove" Click="RemoveSelectedFile"
                        Margin="7,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ClipboardView" Visibility="Collapsed">
            <CheckBox x:Name="ClipboardEnabled" Content="Keep copied text until the app closes"
                      Foreground="{StaticResource Ink}" Margin="1,0,0,8"
                      Checked="ClipboardPreferenceChanged" Unchecked="ClipboardPreferenceChanged"/>
            <Grid Height="72">
                <ListBox x:Name="Clips" ItemTemplate="{StaticResource TextRow}" AutomationProperties.Name="Copied text"/>
                <TextBlock x:Name="ClipboardEmpty" Text="Clipboard history is off" Style="{StaticResource Quiet}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CopyClip" Style="{StaticResource Action}" Content="Copy" Click="CopySelected" IsEnabled="False"/>
                <Button x:Name="ClearClips" Style="{StaticResource Action}" Content="Clear history" Click="ClearClipboard"
                        Margin="7,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="TimerView" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="TimerReadout" Text="25:00" FontSize="28" FontWeight="SemiBold"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <StackPanel x:Name="TimerMinutes" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" AutomationProperties.Name="Timer duration">
                    <RadioButton Style="{StaticResource DurationChoice}" Content="5 min" Tag="5" GroupName="Duration"
                                 Checked="TimerDurationChanged"/>
                    <RadioButton Style="{StaticResource DurationChoice}" Content="25 min" Tag="25" GroupName="Duration"
                                 IsChecked="True" Checked="TimerDurationChanged"/>
                    <RadioButton Style="{StaticResource DurationChoice}" Content="60 min" Tag="60" GroupName="Duration"
                                 Checked="TimerDurationChanged"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="TimerButton" Style="{StaticResource Action}" Content="Start timer" Click="ToggleTimer"/>
                <Button Style="{StaticResource Action}" Content="Reset" Click="ResetTimer" Margin="7,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
