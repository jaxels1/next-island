<UserControl x:Class="SapphireGameHud.IslandPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireGameHud"
        Width="384" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
    <!-- Added 2026-11-12 for the Windows island. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource SecondarySize}"/>
        </Style>
        <Style x:Key="KeyboardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource ControlFill}"/>
            <Setter Property="Padding" Value="{StaticResource ControlInsets}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource ControlHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Shell" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Recessed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ArtworkRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TextRow">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13"/>
        </DataTemplate>
        <DataTemplate x:Key="FileRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Path Width="14" Height="17" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" Data="{StaticResource FileIcon}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Path}"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border x:Name="ScrollThumb" Background="{StaticResource TrackFill}" CornerRadius="3" Margin="2,1"/>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource Muted}"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekTrack" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackFill}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"><Border Height="3" Background="{StaticResource Accent}"
                                                    CornerRadius="1.5" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="22">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent"><Ellipse x:Name="SeekHandle" Width="8" Height="8" Fill="{StaticResource Accent}"/></Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SeekHandle" Property="Width" Value="12"/><Setter TargetName="SeekHandle" Property="Height" Value="12"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="SeekHandle" Property="Width" Value="12"/><Setter TargetName="SeekHandle" Property="Height" Value="12"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DurationChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Choice" CornerRadius="8" Background="Transparent" Padding="7,5"
                                    IsHitTestVisible="False">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Choice" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestinationIcon" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <Style x:Key="DestinationLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>
        <Style x:Key="ClipboardSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" MinHeight="34">
                            <Border x:Name="SwitchTrack" Width="32" Height="18" CornerRadius="9" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Background="{StaticResource TrackFill}">
                                <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Margin="3"
                                         HorizontalAlignment="Left" Fill="{StaticResource Ink}"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource IslandFill}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Destination" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Selection" CornerRadius="{StaticResource ControlRadius}" Margin="2,0"
                                    Background="Transparent" IsHitTestVisible="False" local:ButtonPress.Scale=".96">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{StaticResource Recessed}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Selection" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="PrimaryTransport" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Border x:Name="PlaySurface" Background="{StaticResource Ink}" CornerRadius="22" IsHitTestVisible="False">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlaySurface" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PlaySurface" Property="local:ButtonPress.IsPressed" Value="True"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PlaySurface" Property="Opacity" Value=".4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaybackIcon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Ink}"/>
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="TimerProgressStyle" TargetType="ProgressBar">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" Background="Transparent">
                    <Border Background="{StaticResource TrackFill}" CornerRadius="2"/>
                    <Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="PanelBody" Margin="{StaticResource PanelInsets}">
        <Grid x:Name="Navigation" Margin="0,0,0,16" Height="34" SizeChanged="NavigationSizeChanged"
              AutomationProperties.Name="Island views">
            <Border x:Name="SelectionIndicator" HorizontalAlignment="Left" Background="{StaticResource ControlFill}"
                    CornerRadius="11" IsHitTestVisible="False" Margin="2,0">
                <Border.RenderTransform><TranslateTransform x:Name="SelectionOffset"/></Border.RenderTransform>
            </Border>
            <UniformGrid Columns="4">
                <RadioButton x:Name="MusicTab" Style="{StaticResource Destination}" IsChecked="True" GroupName="IslandView"
                             Tag="Music" Checked="Navigate" AutomationProperties.Name="Music">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource MusicIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Music"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ShelfTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Shelf" Checked="Navigate" AutomationProperties.Name="Shelf">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource ShelfIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Shelf"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ClipboardTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Clipboard" Checked="Navigate" AutomationProperties.Name="Clipboard">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource ClipboardIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Clipboard"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="TimerTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Timer" Checked="Navigate" AutomationProperties.Name="Timer">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource TimerIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Timer"/></StackPanel>
                </RadioButton>
            </UniformGrid>
        </Grid>
        <Grid x:Name="ViewHost" MinHeight="164">
        <StackPanel x:Name="MusicView" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border x:Name="ArtTile" Background="{StaticResource Recessed}" Width="64" Height="64" HorizontalAlignment="Left"
                        VerticalAlignment="Center" CornerRadius="{StaticResource ArtworkRadius}" RenderTransformOrigin=".5,.5">
                    <Grid>
                        <Path Stroke="{StaticResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                              Width="22" Height="22" Data="{StaticResource MusicIcon}"/>
                        <Rectangle x:Name="AlbumArt" RadiusX="10" RadiusY="10" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="TrackDetails" Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock x:Name="TrackName" Text="Nothing playing" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistName" Text="Start playback in a media app."
                               Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="Timeline" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Style="{StaticResource SeekTrack}" IsEnabled="False" IsMoveToPointEnabled="True"
                        SmallChange="5" LargeChange="15" ValueChanged="SeekChanged"
                        PreviewMouseLeftButtonUp="FinishSeek" AutomationProperties.Name="Playback position"/>
                <TextBlock x:Name="Elapsed" Grid.Row="1" Style="{StaticResource Quiet}" FontSize="11"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="Duration" Grid.Row="1" Style="{StaticResource Quiet}" FontSize="11" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <StackPanel x:Name="Transport" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed">
                <Button x:Name="Previous" Style="{StaticResource TransportButton}" Click="PreviousTrack" ToolTip="Previous track"
                        AutomationProperties.Name="Previous track" IsEnabled="False">
                    <Path Style="{StaticResource PlaybackIcon}" Data="{StaticResource PreviousSolid}"/>
                </Button>
                <Button x:Name="Toggle" Style="{StaticResource PrimaryTransport}" Margin="16,0" Click="ToggleTrack"
                        ToolTip="Play" AutomationProperties.Name="Play" IsEnabled="False">
                    <Grid>
                        <Path x:Name="PlayGlyph" Style="{StaticResource PlaybackIcon}" Fill="{StaticResource IslandFill}" Margin="2,0,0,0" Data="{StaticResource PlaySolid}"/>
                        <Path x:Name="PauseGlyph" Style="{StaticResource PlaybackIcon}" Fill="{StaticResource IslandFill}" Opacity="0" Data="{StaticResource PauseSolid}"/>
                    </Grid>
                </Button>
                <Button x:Name="Next" Style="{StaticResource TransportButton}" Click="NextTrack" ToolTip="Next track"
                        AutomationProperties.Name="Next track" IsEnabled="False">
                    <Path Style="{StaticResource PlaybackIcon}" Data="{StaticResource NextSolid}"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="MusicStatus" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel x:Name="ShelfView" Visibility="Collapsed" AllowDrop="True" Drop="AddDroppedFiles"
                    DragOver="ShowDropEffect" DragLeave="LeaveDropTarget" Background="Transparent">
            <Grid Margin="0,0,0,10">
                <TextBlock Text="File shelf" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ShelfCount" Text="0 files" Style="{StaticResource Quiet}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="DropSurface" Background="{StaticResource Recessed}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1">
                <Grid Height="94">
                    <ListBox x:Name="Files" Background="Transparent" ItemTemplate="{StaticResource FileRow}" AutomationProperties.Name="File shelf"
                             PreviewMouseLeftButtonDown="StartFileDrag" PreviewMouseMove="DragFile"
                             MouseDoubleClick="OpenSelectedFile" KeyDown="OpenSelectedFileWithKeyboard"/>
                    <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Width="22" Height="22" Margin="0,0,0,8" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round" Data="{StaticResource ShelfIcon}"/>
                        <TextBlock Text="Drop files here" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag them out when you need them." Style="{StaticResource Quiet}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddFile" Style="{StaticResource Action}" Content="Add files" Click="AddFiles"/>
                    <Button x:Name="RemoveFile" Style="{StaticResource Action}" Background="Transparent" Content="Remove" Click="RemoveSelectedFile" Margin="6,0,0,0" IsEnabled="False"
                            ToolTip="Remove from shelf (Delete). The original file stays where it is."/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ShelfStatus" Style="{StaticResource Quiet}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel x:Name="ClipboardView" Visibility="Collapsed">
            <CheckBox x:Name="ClipboardEnabled" Style="{StaticResource ClipboardSwitch}" Checked="ClipboardPreferenceChanged" Unchecked="ClipboardPreferenceChanged"
                      AutomationProperties.Name="Enable clipboard history">
                <TextBlock Text="Clipboard history" FontSize="14" FontWeight="SemiBold"/>
            </CheckBox>
            <TextBlock Text="Stored only until Next Island closes." Style="{StaticResource Quiet}" Margin="0,0,0,10"/>
            <Grid Height="78">
                <ListBox x:Name="Clips" ItemTemplate="{StaticResource TextRow}" AutomationProperties.Name="Copied text"
                         KeyDown="CopyClipWithKeyboard" MouseDoubleClick="CopySelected"/>
                <TextBlock x:Name="ClipboardEmpty" Text="Turn on history to keep copied text here." Style="{StaticResource Quiet}"
                           TextWrapping="Wrap" Margin="16,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CopyClip" Style="{StaticResource Action}" Content="Copy" Click="CopySelected" MinWidth="64" IsEnabled="False" ToolTip="Copy selected text (Ctrl+C)"/>
                <Button x:Name="ClearClips" Style="{StaticResource Action}" Background="Transparent" Content="Clear history" Click="ClearClipboard" Margin="6,0,0,0" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="ClipboardStatus" Style="{StaticResource Quiet}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel x:Name="TimerView" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid>
                <TextBlock x:Name="TimerReadout" Text="25:00" FontSize="36" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="TimerState" Text="Ready" Style="{StaticResource Quiet}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="TimerProgress" Height="3" Minimum="0" Maximum="1" Value="1" Margin="0,10,0,14"
                         Style="{StaticResource TimerProgressStyle}" AutomationProperties.Name="Time remaining"/>
            <UniformGrid x:Name="TimerMinutes" Columns="3" Margin="-3,0,0,14" AutomationProperties.Name="Timer duration">
                <RadioButton Style="{StaticResource DurationChoice}" Content="5 min" Tag="5" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="25 min" Tag="25" GroupName="Duration" IsChecked="True" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="60 min" Tag="60" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TimerButton" Style="{StaticResource Action}" Content="Start timer" Click="ToggleTimer" MinWidth="105"/>
                <Button x:Name="TimerReset" Style="{StaticResource Action}" Background="Transparent" Content="Reset" Click="ResetTimer" Margin="6,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
