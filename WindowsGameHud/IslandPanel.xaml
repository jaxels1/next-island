<UserControl x:Class="SapphireGameHud.IslandPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireGameHud"
        Width="384" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
    <!-- Added 2026-11-12 for the Windows island. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="LiveAccent" Color="#C7D6F6"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="{StaticResource SecondarySize}"/>
        </Style>
        <Style x:Key="KeyboardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource ControlFill}"/>
            <Setter Property="Padding" Value="{StaticResource ControlInsets}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource ControlHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Shell" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Recessed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ArtworkRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TextRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="5" Height="5" Fill="{DynamicResource LiveAccent}" Margin="0,0,6,0" VerticalAlignment="Center"
                         Visibility="{Binding PinVisibility}"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding AgeLabel}" Style="{StaticResource Quiet}" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Width="14" Height="16" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource FileIcon}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource FolderIcon}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Style="{StaticResource Quiet}" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border x:Name="ScrollThumb" Background="{StaticResource TrackFill}" CornerRadius="3" Margin="2,1"/>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource Muted}"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekTrack" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackFill}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"><Border Height="3" Background="{DynamicResource LiveAccent}"
                                                    CornerRadius="1.5" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="22">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent"><Ellipse x:Name="SeekHandle" Width="8" Height="8" Fill="{DynamicResource LiveAccent}"/></Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SeekHandle" Property="Width" Value="12"/><Setter TargetName="SeekHandle" Property="Height" Value="12"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="SeekHandle" Property="Width" Value="12"/><Setter TargetName="SeekHandle" Property="Height" Value="12"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeTrack" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackFill}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Height="20">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"><Border Height="3" Background="{StaticResource Muted}"
                                                    CornerRadius="1.5" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="20">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent"><Ellipse x:Name="VolumeHandle" Width="7" Height="7" Fill="{StaticResource Ink}"/></Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="VolumeHandle" Property="Width" Value="10"/><Setter TargetName="VolumeHandle" Property="Height" Value="10"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="VolumeHandle" Property="Width" Value="10"/><Setter TargetName="VolumeHandle" Property="Height" Value="10"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DurationChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Choice" CornerRadius="8" Background="Transparent" Padding="6,5"
                                    IsHitTestVisible="False">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Choice" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestinationIcon" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <Style x:Key="DestinationLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface" Background="Transparent" Padding="8,6" CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource ControlHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ChoiceSurface" Background="{StaticResource ControlFill}" CornerRadius="8"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource ControlHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <DockPanel Margin="9,0" IsHitTestVisible="False">
                                <Path DockPanel.Dock="Right" Data="M0,0 L3,3 6,0" Stroke="{StaticResource Muted}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"/>
                            </DockPanel>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{StaticResource Recessed}" BorderBrush="{StaticResource IslandRim}"
                                        BorderThickness="1" CornerRadius="8" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" MinHeight="32" LastChildFill="True">
                            <Border x:Name="SwitchTrack" DockPanel.Dock="Right" Width="34" Height="20" CornerRadius="10" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Background="{StaticResource TrackFill}">
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Margin="2"
                                         HorizontalAlignment="Left" Fill="{StaticResource Ink}"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource IslandFill}"/>
                                <Setter TargetName="SwitchThumb" Property="local:ButtonPress.OffsetX" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Destination" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Selection" CornerRadius="9" Margin="3"
                                    Background="Transparent" IsHitTestVisible="False" local:ButtonPress.Scale=".96">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{StaticResource Recessed}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{StaticResource ControlPressed}"/>
                                <Setter TargetName="Selection" Property="local:ButtonPress.IsPressed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="PrimaryTransport" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Border x:Name="PlaySurface" Background="{StaticResource Ink}" CornerRadius="22" IsHitTestVisible="False">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlaySurface" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PlaySurface" Property="local:ButtonPress.IsPressed" Value="True"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PlaySurface" Property="Opacity" Value=".4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaybackIcon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Ink}"/>
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="TimerProgressStyle" TargetType="ProgressBar">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" Background="Transparent">
                    <Border Background="{StaticResource TrackFill}" CornerRadius="2"/>
                    <Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="PanelBody" Margin="{StaticResource PanelInsets}">
        <Grid x:Name="NavigationHeader" Margin="0,0,0,16" Height="34">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="Navigation" SizeChanged="NavigationSizeChanged" AutomationProperties.Name="Island views">
            <Border Background="{StaticResource NavigationFill}" CornerRadius="12" IsHitTestVisible="False"/>
            <Border x:Name="SelectionIndicator" HorizontalAlignment="Left" Background="{StaticResource ControlFill}"
                    CornerRadius="9" IsHitTestVisible="False" Margin="3">
                <Border.RenderTransform><TranslateTransform x:Name="SelectionOffset"/></Border.RenderTransform>
            </Border>
            <UniformGrid Columns="4">
                <RadioButton x:Name="MusicTab" Style="{StaticResource Destination}" IsChecked="True" GroupName="IslandView"
                             Tag="Music" Checked="Navigate" AutomationProperties.Name="Music">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource MusicIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Music"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ShelfTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Shelf" Checked="Navigate" AutomationProperties.Name="Shelf">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource ShelfIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Shelf"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ClipboardTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Clipboard" Checked="Navigate" AutomationProperties.Name="Clipboard">
                    <StackPanel Orientation="Horizontal"><Path x:Name="ClipboardTabIcon" Style="{StaticResource DestinationIcon}" Data="{StaticResource ClipboardIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Clipboard"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="TimerTab" Style="{StaticResource Destination}" GroupName="IslandView"
                             Tag="Timer" Checked="Navigate" AutomationProperties.Name="Timer">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource DestinationIcon}" Data="{StaticResource TimerIcon}"/><TextBlock Style="{StaticResource DestinationLabel}" Text="Timer"/></StackPanel>
                </RadioButton>
            </UniformGrid>
            </Grid>
            <Button x:Name="SettingsButton" Grid.Column="1" Width="32" Height="32" Margin="4,0,0,0" Padding="0"
                    Background="Transparent" Style="{StaticResource Action}" Click="ToggleSettings"
                    ToolTip="Settings" AutomationProperties.Name="Settings">
                <Path Data="{StaticResource SettingsIcon}" Width="16" Height="16" Stretch="Uniform"
                      Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
            </Button>
        </Grid>
        <Grid x:Name="ViewHost" MinHeight="164" ClipToBounds="True">
        <StackPanel x:Name="MusicView" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Ellipse x:Name="ArtGlow" Grid.ColumnSpan="2" Width="140" Height="140" Margin="-34,-34,0,-34"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="ArtGlowStop" Color="#C7D6F6" Offset="0"/>
                            <GradientStop Color="#00C7D6F6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Border x:Name="ArtTile" Background="{StaticResource Recessed}" Width="72" Height="72" HorizontalAlignment="Left"
                        VerticalAlignment="Center" CornerRadius="{StaticResource ArtworkRadius}" RenderTransformOrigin=".5,.5">
                    <Grid>
                        <Path Stroke="{StaticResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                              Width="22" Height="22" Data="{StaticResource MusicIcon}"/>
                        <Rectangle x:Name="AlbumArt" RadiusX="12" RadiusY="12" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="TrackDetails" Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock x:Name="TrackName" Text="Nothing playing" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistName" Text="Start playback in a media app."
                               Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Transport" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                <Button x:Name="Previous" Style="{StaticResource TransportButton}" Click="PreviousTrack" ToolTip="Previous track"
                        AutomationProperties.Name="Previous track" IsEnabled="False">
                    <Path Style="{StaticResource PlaybackIcon}" Data="{StaticResource PreviousSolid}"/>
                </Button>
                <Button x:Name="Toggle" Style="{StaticResource PrimaryTransport}" Margin="16,0" Click="ToggleTrack"
                        ToolTip="Play" AutomationProperties.Name="Play" IsEnabled="False">
                    <Grid>
                        <Path x:Name="PlayGlyph" Style="{StaticResource PlaybackIcon}" Fill="{StaticResource IslandFill}" Margin="2,0,0,0" Data="{StaticResource PlaySolid}"/>
                        <Path x:Name="PauseGlyph" Style="{StaticResource PlaybackIcon}" Fill="{StaticResource IslandFill}" Opacity="0" Data="{StaticResource PauseSolid}"/>
                    </Grid>
                </Button>
                <Button x:Name="Next" Style="{StaticResource TransportButton}" Click="NextTrack" ToolTip="Next track"
                        AutomationProperties.Name="Next track" IsEnabled="False">
                    <Path Style="{StaticResource PlaybackIcon}" Data="{StaticResource NextSolid}"/>
                </Button>
            </StackPanel>
            <Grid x:Name="Timeline" Margin="0,2,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Style="{StaticResource SeekTrack}" IsEnabled="False" IsMoveToPointEnabled="True"
                        SmallChange="5" LargeChange="15" ValueChanged="SeekChanged"
                        PreviewMouseLeftButtonUp="FinishSeek" AutomationProperties.Name="Playback position"/>
                <TextBlock x:Name="Elapsed" Grid.Row="1" Style="{StaticResource Quiet}" FontSize="11"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="Duration" Grid.Row="1" Style="{StaticResource Quiet}" FontSize="11" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular" Cursor="Hand" Background="Transparent"
                           MouseLeftButtonUp="ToggleRemainingTime" ToolTip="Click to toggle remaining time"/>
            </Grid>
            <Grid x:Name="VolumeRow" Margin="0,2,0,0" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Width="24" Height="20" Padding="0" Background="Transparent"
                        Style="{StaticResource Action}" MinHeight="20" Click="ToggleMute"
                        ToolTip="Mute (Ctrl+M)" AutomationProperties.Name="Mute">
                    <Path x:Name="VolumeIcon" Width="13" Height="13" Stretch="Uniform"
                          Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource VolumeHighIcon}"/>
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Style="{StaticResource VolumeTrack}"
                        ValueChanged="VolumeSliderChanged" AutomationProperties.Name="System volume"/>
                <TextBlock x:Name="VolumePercent" Grid.Column="2" Style="{StaticResource Quiet}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Text="—"/>
            </Grid>
            <TextBlock x:Name="MusicStatus" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel x:Name="ShelfView" Visibility="Collapsed" AllowDrop="True" Drop="AddDroppedFiles"
                    DragOver="ShowDropEffect" DragLeave="LeaveDropTarget" Background="Transparent">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="File shelf" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ShelfCount" Text="0 files" Style="{StaticResource Quiet}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="DropSurface" Background="{StaticResource Recessed}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1">
                <Grid Height="90">
                    <ListBox x:Name="Files" Background="Transparent" ItemTemplate="{StaticResource FileRow}" AutomationProperties.Name="File shelf"
                             PreviewMouseLeftButtonDown="StartFileDrag" PreviewMouseMove="DragFile"
                             MouseDoubleClick="OpenSelectedFile" KeyDown="OpenSelectedFileWithKeyboard"/>
                    <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Width="22" Height="22" Margin="0,0,0,6" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round" Data="{StaticResource ShelfIcon}"/>
                        <TextBlock Text="Drop files here" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag them out when you need them." Style="{StaticResource Quiet}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddFile" Style="{StaticResource CompactAction}" Content="Add files" Click="AddFiles"/>
                    <Button x:Name="RevealFile" Style="{StaticResource CompactAction}" Background="Transparent" Content="Reveal" Click="RevealSelectedFile" Margin="4,0,0,0" IsEnabled="False"
                            ToolTip="Show in File Explorer"/>
                    <Button x:Name="RemoveFile" Style="{StaticResource CompactAction}" Background="Transparent" Content="Remove" Click="RemoveSelectedFile" Margin="4,0,0,0" IsEnabled="False"
                            ToolTip="Remove from shelf (Delete). The original file stays where it is."/>
                    <Button x:Name="ClearShelf" Style="{StaticResource CompactAction}" Background="Transparent" Content="Clear" Click="ClearAllShelf" Margin="4,0,0,0" IsEnabled="False"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ShelfStatus" Style="{StaticResource Quiet}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel x:Name="ClipboardView" Visibility="Collapsed">
            <CheckBox x:Name="ClipboardEnabled" Style="{StaticResource ClipboardSwitch}" Checked="ClipboardPreferenceChanged" Unchecked="ClipboardPreferenceChanged"
                      AutomationProperties.Name="Enable clipboard history">
                <TextBlock Text="Clipboard history" FontSize="14" FontWeight="SemiBold"/>
            </CheckBox>
            <TextBlock Text="Stored only until Next Island closes." Style="{StaticResource Quiet}" Margin="0,0,0,6"/>
            <Border x:Name="ClipFilterBox" Background="{StaticResource Recessed}" CornerRadius="8" Height="22" Padding="7,0" Margin="0,0,0,5" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Data="{StaticResource SearchIcon}"/>
                    <TextBox x:Name="ClipFilter" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" FontSize="12"
                             VerticalContentAlignment="Center" Padding="0" TextChanged="ClipFilterChanged"
                             AutomationProperties.Name="Filter clipboard history"/>
                    <TextBlock x:Name="ClipFilterHint" Grid.Column="1" Text="Filter clips…" Style="{StaticResource Quiet}"
                               FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Grid Height="62">
                <ListBox x:Name="Clips" ItemTemplate="{StaticResource TextRow}" AutomationProperties.Name="Copied text"
                         KeyDown="CopyClipWithKeyboard" MouseDoubleClick="CopySelected"/>
                <TextBlock x:Name="ClipboardEmpty" Text="Turn on history to keep copied text here." Style="{StaticResource Quiet}"
                           TextWrapping="Wrap" Margin="16,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="CopyClip" Style="{StaticResource CompactAction}" Content="Copy" Click="CopySelected" MinWidth="58" IsEnabled="False" ToolTip="Copy selected text (Ctrl+C)"/>
                <Button x:Name="PinClip" Style="{StaticResource CompactAction}" Background="Transparent" Content="Pin" Click="TogglePinClip" Margin="4,0,0,0" IsEnabled="False"/>
                <Button x:Name="ClearClips" Style="{StaticResource CompactAction}" Background="Transparent" Content="Clear history" Click="ClearClipboard" Margin="4,0,0,0" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="ClipboardStatus" Style="{StaticResource Quiet}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel x:Name="TimerView" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid>
                <TextBlock x:Name="TimerReadout" Text="25:00" FontSize="36" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="TimerState" Text="Ready" Style="{StaticResource Quiet}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="TimerProgress" Height="3" Minimum="0" Maximum="1" Value="1" Margin="0,10,0,14"
                         Style="{StaticResource TimerProgressStyle}" AutomationProperties.Name="Time remaining"/>
            <UniformGrid x:Name="TimerMinutes" Columns="5" Margin="-3,0,0,14" AutomationProperties.Name="Timer duration">
                <RadioButton Style="{StaticResource DurationChoice}" Content="1m" Tag="1" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="5m" Tag="5" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="15m" Tag="15" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="25m" Tag="25" GroupName="Duration" IsChecked="True" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
                <RadioButton Style="{StaticResource DurationChoice}" Content="60m" Tag="60" GroupName="Duration" Checked="TimerDurationChanged" HorizontalContentAlignment="Center"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TimerButton" Style="{StaticResource Action}" Content="Start timer" Click="ToggleTimer" MinWidth="105"/>
                <Button x:Name="TimerAddMinute" Style="{StaticResource Action}" Background="Transparent" Content="+1 min" Click="AddTimerMinute" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="TimerReset" Style="{StaticResource Action}" Background="Transparent" Content="Reset" Click="ResetTimer" Margin="6,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="SettingsView" Visibility="Collapsed">
            <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer x:Name="SettingsOptions" MaxHeight="127" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,8,0">
                    <CheckBox x:Name="GraphSwitch" Style="{StaticResource ClipboardSwitch}" Content="Frame time graph"
                              Click="ChangeGraphSetting"/>
                    <CheckBox x:Name="LargeTextSwitch" Style="{StaticResource ClipboardSwitch}" Content="Larger HUD text"
                              Click="ChangeTextSetting"/>
                    <DockPanel Margin="0,6,0,4">
                        <TextBlock Text="Island mode" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="DisplayChoice" Style="{StaticResource SettingsChoice}"
                                  AutomationProperties.Name="Island mode" SelectionChanged="ChangeDisplayMode">
                            <ComboBoxItem Content="Automatic island" Tag="Automatic"/>
                            <ComboBoxItem Content="Pin game HUD" Tag="Always"/>
                            <ComboBoxItem Content="Hide island" Tag="Hidden"/>
                            <ComboBoxItem Content="Preview layout" Tag="Preview"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="RuleAppName" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" Margin="0,6,0,4"/>
                    <ComboBox x:Name="GameRuleChoice" Style="{StaticResource SettingsChoice}"
                              AutomationProperties.Name="Game detection" SelectionChanged="ChangeGameRule">
                        <ComboBoxItem Content="Use automatic game detection"/>
                        <ComboBoxItem Content="Treat this app as a game"/>
                        <ComboBoxItem Content="Never show the HUD for this app"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Button Style="{StaticResource Action}" Content="Choose PresentMon…" Click="ChooseFrameProvider"/>
                        <Button x:Name="SensorSetupButton" Style="{StaticResource Action}" Content="Sensor setup…" Margin="6,0,0,0"
                                Click="OpenSensors"/>
                    </StackPanel>
                    <TextBlock x:Name="ProviderStatus" Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Quiet}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="UpdateButton" Style="{StaticResource Action}" Content="Check for updates" Click="CheckForUpdates"/>
                <Button x:Name="QuitButton" Style="{StaticResource Action}" Content="Quit app" Background="Transparent" Margin="6,0,0,0" Click="QuitApp"/>
            </StackPanel>
        </StackPanel>
        <Canvas x:Name="ViewTransitionLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </StackPanel>
</UserControl>
